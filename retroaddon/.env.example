# Twitch developer credentials (https://dev.twitch.tv/console/apps) — used for the IGDB API.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Where the SQLite database lives (default: ./data/games.db)
DB_PATH=./data/games.db

# Port the addon listens on
PORT=7000

# Public URL of this addon, without trailing slash (e.g. https://retro.example.com).
# Optional; enables in-app genre/platform links on the meta page.
PUBLIC_URL=

# Default launcher URL template used for the "Launch" stream. Users can override it
# in the addon's configure page. Placeholders: {igdb_id} {name} {slug} {platform}
# {platform_id} {year} — all values are URL-encoded. Examples:
#   https://emulator.example.com/play?system={platform}&game={name}
#   retrolaunch://{platform}/{slug}
LAUNCHER_URL_TEMPLATE=
